# Copy to campaign.env, fill in, then: set -a; source campaign.env; set +a
# Every value here is site-specific. Nothing is guessed for you.

HOSTS="gpu-a gpu-b"                       # ssh-reachable hosts in the job
TOPOLOGY=./topology.yaml                  # rank -> host/device/leaf map (nicprof discover helps)
TRAIN_CMD="ssh gpu-a 'cd /work && torchrun ... examples/pytorch_training_hook.py'"   # must write $REMOTE_DIR/steps.rank*.jsonl
ETHTOOL_IFS="ens1f0np0"                   # RoCE netdevs for PFC counters (optional)
NIC_BDFS="0000:3b:00.0"                   # NIC PCI addresses, for read-only LnkCap/LnkSta checks

# Per-experiment targets (only the ones you run)
TARGET_HOST=gpu-b                         # host to inject on
TARGET_IF=ens1f0np0                       # H5: interface to downshift
TARGET_SPEED_MBPS=200000                  # H5: forced speed
TARGET_BRIDGE_BDF=0000:3a:00.0            # H3: PCIe downstream port ABOVE the NIC (lspci -t)
TARGET_GEN=3                              # H3: target link speed (1=2.5, 2=5, 3=8, 4=16, 5=32 GT/s)
TARGET_PF=ens1f0np0                       # H6: SR-IOV PF
TARGET_VF=0                               # H6: VF index
TARGET_VF_RATE_MBPS=180000                # H6: cap
TARGET_GPU=0                              # H8: GPU index on TARGET_HOST
TARGET_GPU_CLOCKS="210,600"               # H8: min,max MHz for nvidia-smi -lgc
BW_DEVICE=mlx5_0                          # H1/H10: device for ib_write_bw
BW_SERVER=gpu-c                           # H1/H10: traffic sink across the leaf uplinks
BW_CLIENT=gpu-d                           # H1/H10: traffic source under the other leaf

# Switch changes are vendor-specific; supply your own exact commands (run on the switch or via its API).
SWITCH_INJECT_CMD=""
SWITCH_REVERT_CMD=""
